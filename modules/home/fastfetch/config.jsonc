{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ascii.txt", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
        "top": 0,
        "left": 0,
        "right": 4
        },
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",
	"separator",
	"os",
	"host",
	"kernel",
	"uptime",
	"packages",
	"shell",
	"display",
	"de",
	"wm",
	"wmtheme",
	"theme",
	"icons",
	"font",
	"cursor",
	"terminal",
	"terminalfont",
	"cpu",
	"gpu",
	"memory",
	"swap",
	"disk",
	"localip",
	"battery",
	"poweradapter",
	"locale",
	"break",
	"colors",
    ]
}
