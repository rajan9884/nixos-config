#!/usr/bin/env bash
# ──────────────────────────────────────────────
#   nixos-theme-apply — apply a system theme by name.
#   Usage: nixos-theme-apply <Theme Name>
#   Relinks hypr/waybar/rofi theme files, picks a random wallpaper from
#   the full collection, runs matugen to extract colors from the wallpaper,
#   and reloads the session.
# ──────────────────────────────────────────────

set -e

THEME_IN=$(echo "$1" | tr '[:upper:]' '[:lower:]')
if [[ -z $THEME_IN ]]; then
  echo "Usage: nixos-theme-apply <Theme Name>" >&2
  exit 1
fi
THEME="$1"

WALL_DIR="$HOME/.local/share/wallpapers"
SWWW_SCRIPT="$HOME/.config/hypr/scripts/swww-all.sh"
ACTIVE_THEME_FILE="$HOME/.config/hypr/.active-theme"

case "$THEME_IN" in
  *material*) HYPR="material"; WAYBAR="floating-bar" ;;
  *retro*)    HYPR="retro";    WAYBAR="retro-left" ;;
  *modern*)   HYPR="modern";   WAYBAR="bottom-dock" ;;
  *glass*)    HYPR="glass";    WAYBAR="glass-right" ;;
  *noro*)     HYPR="noro";     WAYBAR="noro" ;;
  *) echo "Unknown theme: $THEME" >&2; exit 1 ;;
esac

# ── 1. Apply Selections ──
# NOTE: theme.conf (.conf layer) is retired — Lua is authoritative, so only
# theme.lua is relinked. See hyprland.lua.
if [ -f "$HOME/.config/hypr/themes/$HYPR/theme.lua" ]; then
    ln -sf "$HOME/.config/hypr/themes/$HYPR/theme.lua" "$HOME/.config/hypr/theme.lua"
fi
ln -sf "$HOME/.config/waybar/themes/$WAYBAR/config.jsonc" "$HOME/.config/waybar/config.jsonc"
ln -sf "$HOME/.config/waybar/themes/$WAYBAR/style.css" "$HOME/.config/waybar/style.css"
ln -sf "$HOME/.config/rofi/themes/$HYPR/launcher.rasi" "$HOME/.config/rofi/active-launcher.rasi"
ln -sf "$HOME/.config/rofi/themes/$HYPR/scripts.rasi" "$HOME/.config/rofi/active-scripts.rasi"
ln -sf "$HOME/.config/rofi/themes/$HYPR/picker.rasi" "$HOME/.config/rofi/active-picker.rasi"

# ── 2. Save active theme ──
echo "$THEME" > "$ACTIVE_THEME_FILE"

# ── 3. Apply Wallpaper (random from the flat collection) ──
# Flat store: ~/.local/share/wallpapers/*.jpg (wallpapers-sync, no subdirs).
SELECTED_WALL=$(find "$WALL_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \) 2>/dev/null | shuf -n 1)
[ -n "$SELECTED_WALL" ] && "$SWWW_SCRIPT" "$SELECTED_WALL"

# ── 4. Reload ──
hyprctl reload
# Restart via systemd so exactly one bar survives (never `waybar &` — that stacks).
systemctl --user restart waybar.service 2>/dev/null || { killall -q waybar .waybar-wrapped 2>/dev/null; waybar & disown; }

notify-send "  Theme: $THEME" "Full system aesthetic updated" -i preferences-desktop-theme